---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';

type Props = CollectionEntry<'projects'>['data'];

const { title, description, pubDate, stack, github, live } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <article>
    <a class="back-link" href="/projects">back to projects</a>
    <div class="post-header">
      <h1>{title}</h1>
      <div class="post-meta">
        <FormattedDate date={pubDate} />
      </div>
      {stack?.length > 0 && (
        <div class="project-tags" style="margin-top: 0.5rem;">
          {stack.map((tech: string) => (
            <span class="tag">{tech}</span>
          ))}
        </div>
      )}
      {(github || live) && (
        <div class="project-links">
          {github && <a href={github} target="_blank" rel="noreferrer">source code ↗</a>}
          {live && <a href={live} target="_blank" rel="noreferrer">live site ↗</a>}
        </div>
      )}
    </div>
    <div class="prose">
      <slot />
    </div>
  </article>
</BaseLayout>
