---
import type { CollectionEntry } from 'astro:content';

interface Props {
  projects: CollectionEntry<'projects'>[];
}

const { projects } = Astro.props;
const shellProjects = projects.map((project) => project.id);
---

<section class="filesystem" aria-labelledby="filesystem-title" data-shell-projects={JSON.stringify(shellProjects)}>
  <div class="filesystem-heading">
    <h2 id="filesystem-title"><span class="folder-icon" aria-hidden="true"></span>pawan/</h2>
    <p class="filesystem-note">an index of my work and interests</p>
  </div>

  <div class="directory-group">
    <div class="group-heading"><span class="folder-icon small" aria-hidden="true"></span><h3>profile/</h3></div>
    <div class="tree">
      <div class="tree-row">
        <span class="tree-entry"><span class="file-icon" aria-hidden="true"></span><span class="entry-name">about.md</span></span>
        <span class="entry-description">backend engineer, based in Singapore</span>
      </div>
      <div class="tree-row">
        <span class="tree-entry"><span class="file-icon" aria-hidden="true"></span><span class="entry-name">now.md</span></span>
        <span class="entry-description">building reliable real-time systems</span>
      </div>
      <a class="tree-row" href="/Pawan_Resume_Backend_Software_Engineer.pdf" target="_blank">
        <span class="tree-entry"><span class="file-icon" aria-hidden="true"></span><span class="entry-name">resume.pdf</span></span>
        <span class="entry-description">experience, skills, and education</span><span class="entry-arrow" aria-hidden="true">↗</span>
      </a>
    </div>
  </div>

  <div class="directory-group">
    <div class="group-heading"><span class="folder-icon small" aria-hidden="true"></span><h3>experience/</h3></div>
    <div class="tree">
      <a class="tree-row" href="/experience">
        <span class="tree-entry"><span class="file-icon" aria-hidden="true"></span><span class="entry-name">venti.md</span></span>
        <span class="entry-description">infrastructure for autonomous vehicles</span><span class="entry-arrow" aria-hidden="true">→</span>
      </a>
      <a class="tree-row" href="/experience">
        <span class="tree-entry"><span class="file-icon" aria-hidden="true"></span><span class="entry-name">nus.md</span></span>
        <span class="entry-description">robotics, vision, and real-time software</span>
        <span class="entry-arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </div>

  <div class="directory-group">
    <div class="group-heading"><span class="folder-icon small" aria-hidden="true"></span><h3>projects/</h3><a class="group-link" href="/projects">view all →</a></div>
    <div class="tree">
      {projects.map((project) => (
        <a class="tree-row project-row" href={`/projects/${project.id}/`}>
          <span class="tree-entry"><span class="folder-icon small" aria-hidden="true"></span><span class="entry-name">{project.data.title}</span></span>
          <span class="entry-description">{project.data.description}</span>
          <span class="entry-arrow" aria-hidden="true">→</span>
        </a>
      ))}
    </div>
  </div>

  <div class="directory-group">
    <div class="group-heading"><span class="folder-icon small" aria-hidden="true"></span><h3>elsewhere/</h3></div>
    <div class="tree">
      <a class="tree-row" href="/blog">
        <span class="tree-entry"><span class="folder-icon small" aria-hidden="true"></span><span class="entry-name">writing/</span></span>
        <span class="entry-description">empty for now — stories will live here</span>
        <span class="entry-arrow" aria-hidden="true">→</span>
      </a>
      <a class="tree-row" href="/contact">
        <span class="tree-entry"><span class="file-icon" aria-hidden="true"></span><span class="entry-name">contact.json</span></span>
        <span class="entry-description">GitHub, LinkedIn, X, and email</span>
        <span class="entry-arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </div>

  <div class="shell" data-shell>
    <div class="shell-bar">
      <span>terminal</span>
      <span>type “help” for commands</span>
    </div>
    <div class="shell-output" data-shell-output aria-live="polite">
      <p>portfolio mounted — try <b>ls</b> or <b>ls resume</b></p>
    </div>
    <form class="shell-prompt" data-shell-form autocomplete="off">
      <label class="sr-only" for="portfolio-command">Portfolio command</label>
      <span aria-hidden="true">pawan@singapore:~/pawan$</span>
      <input id="portfolio-command" data-shell-input type="text" inputmode="text" spellcheck="false" aria-describedby="shell-hint" />
      <span class="input-cursor" aria-hidden="true"></span>
    </form>
    <p class="shell-hint" id="shell-hint">↑↓ history · tab completes · try “ls resume”</p>
  </div>
</section>

<script>
  const filesystem = document.querySelector<HTMLElement>('.filesystem');
  const shell = filesystem?.querySelector<HTMLElement>('[data-shell]');
  const form = filesystem?.querySelector<HTMLFormElement>('[data-shell-form]');
  const input = filesystem?.querySelector<HTMLInputElement>('[data-shell-input]');
  const output = filesystem?.querySelector<HTMLElement>('[data-shell-output]');

  if (filesystem && shell && form && input && output) {
    const projects = JSON.parse(filesystem.dataset.shellProjects || '[]') as string[];
    const history: string[] = [];
    let historyIndex = 0;
    const commands = ['help', 'ls', 'pwd', 'whoami', 'cat', 'cd', 'open', 'clear', 'history'];
    const targets = ['about', 'now', 'experience', 'projects', 'writing', 'blog', 'resume', 'contact'];
    const routes: Record<string, string> = {
      experience: '/experience',
      projects: '/projects',
      writing: '/blog',
      blog: '/blog',
      resume: '/Pawan_Resume_Backend_Software_Engineer.pdf',
      contact: '/contact',
    };

    const write = (text: string, kind = '') => {
      const line = document.createElement('p');
      line.textContent = text;
      if (kind) line.className = kind;
      output.append(line);
      output.scrollTop = output.scrollHeight;
    };

    const navigate = (target: string) => {
      const route = routes[target];
      if (!route) return false;
      write(`opening ${target}${target === 'resume' ? '.pdf' : '/'}…`, 'shell-success');
      window.setTimeout(() => window.location.assign(route), 220);
      return true;
    };

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const raw = input.value.trim();
      if (!raw) return;
      history.push(raw);
      historyIndex = history.length;
      write(`pawan@singapore:~/pawan$ ${raw}`, 'shell-command');
      input.value = '';

      const [command = '', rawTarget = ''] = raw.toLowerCase().split(/\s+/);
      const target = rawTarget.replace(/\.(md|pdf|json)$/, '').replace(/\/$/, '');

      if (command === 'clear') {
        output.replaceChildren();
      } else if (command === 'help') {
        write('help · ls [folder] · cd <folder> · cat <file> · open <file> · pwd · whoami · history · clear');
      } else if (command === 'pwd') {
        write('/home/pawan/portfolio');
      } else if (command === 'whoami') {
        write('Pawan Patil — backend software engineer in Singapore.');
      } else if (command === 'history') {
        history.forEach((item, index) => write(`${index + 1}  ${item}`));
      } else if (command === 'ls') {
        if (!target) write('about.md  now.md  experience/  projects/  writing/  resume.pdf  contact.json');
        else if (target === 'resume') navigate('resume');
        else if (target === 'projects') write(projects.map((project) => `${project}/`).join('  '));
        else if (target === 'experience') write('venti/  nus/');
        else if (target === 'writing' || target === 'blog') write('(empty — check back soon)');
        else write(`ls: ${rawTarget}: no such file or directory`, 'shell-error');
      } else if (command === 'cat') {
        if (target === 'about') write('Backend engineer building real-time data systems and developer tools at Venti.');
        else if (target === 'now') write('Learning more about event-driven systems, storage engines, and operable production software.');
        else if (target === 'contact') navigate('contact');
        else write(`cat: ${rawTarget || 'missing file operand'}: cannot read`, 'shell-error');
      } else if (command === 'cd' || command === 'open') {
        if (!target) write(command === 'cd' ? '/home/pawan/portfolio' : 'open: missing target');
        else if (!navigate(target)) write(`${command}: ${rawTarget}: no such destination`, 'shell-error');
      } else {
        write(`${command}: command not found. Type “help”.`, 'shell-error');
      }
    });

    input.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowUp' || event.key === 'ArrowDown') {
        event.preventDefault();
        const step = event.key === 'ArrowUp' ? -1 : 1;
        historyIndex = Math.max(0, Math.min(history.length, historyIndex + step));
        input.value = history[historyIndex] || '';
      }

      if (event.key === 'Tab') {
        event.preventDefault();
        const parts = input.value.trimStart().split(/\s+/);
        const candidates = parts.length <= 1 ? commands : targets;
        const fragment = parts.at(-1)?.toLowerCase() || '';
        const matches = candidates.filter((candidate) => candidate.startsWith(fragment));
        if (matches.length === 1) {
          parts[parts.length - 1] = matches[0];
          input.value = `${parts.join(' ')}${parts.length === 1 ? ' ' : ''}`;
        } else if (matches.length > 1) {
          write(matches.join('  '));
        }
      }
    });

    shell.addEventListener('click', () => input.focus());
  }
</script>

<style>
  .filesystem {
    --tree-line: color-mix(in srgb, var(--line), transparent 12%);
    margin-bottom: 2rem;
  }

  .filesystem-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 2rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid var(--line);
  }

  .filesystem-heading h2 {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0;
    font-size: 0.92rem;
    font-weight: 500;
  }

  .filesystem-note {
    margin: 0;
    color: var(--faint);
    font-family: var(--sans);
    font-size: 0.68rem;
  }

  .directory-group { margin-top: 2rem; }

  .group-heading {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 1.8rem;
    margin-bottom: 0.45rem;
  }

  .group-heading h3 { margin: 0; color: var(--text); font-size: 0.73rem; font-weight: 500; }
  .group-link { margin-left: auto; color: var(--faint); font-size: 0.61rem; }

  .tree {
    position: relative;
    margin-left: 0.39rem;
    padding-left: 1.55rem;
  }

  .tree::before {
    content: '';
    position: absolute;
    inset: 0 auto 1.15rem 0;
    width: 1px;
    background: var(--tree-line);
  }

  .tree-row {
    position: relative;
    display: grid;
    grid-template-columns: minmax(180px, 0.8fr) minmax(0, 1.35fr) 1rem;
    align-items: center;
    gap: 1.4rem;
    min-height: 2.45rem;
    padding: 0.28rem 0.35rem 0.28rem 0;
    border-radius: 3px;
    color: inherit;
    transition: background 160ms ease, transform 160ms ease;
  }

  .tree-row::before {
    content: '';
    position: absolute;
    top: 50%;
    right: calc(100% + 0.05rem);
    width: 1.5rem;
    height: 1px;
    background: var(--tree-line);
  }

  a.tree-row:hover {
    background: color-mix(in srgb, var(--text) 3%, transparent);
    text-decoration: none;
    transform: translateX(3px);
  }

  .tree-entry { display: flex; align-items: center; gap: 0.6rem; min-width: 0; font-size: 0.73rem; }
  .entry-name { overflow: hidden; color: var(--text); text-overflow: ellipsis; white-space: nowrap; }
  .entry-description { overflow: hidden; color: var(--faint); font-family: var(--sans); font-size: 0.7rem; line-height: 1.45; text-overflow: ellipsis; white-space: nowrap; }
  .entry-arrow { color: var(--faint); font-size: 0.65rem; opacity: 0; transform: translateX(-3px); transition: opacity 160ms ease, transform 160ms ease; }
  a.tree-row:hover .entry-arrow, a.tree-row:focus-visible .entry-arrow { opacity: 1; transform: translateX(0); }

  .folder-icon {
    position: relative;
    display: inline-block;
    width: 0.92rem;
    height: 0.62rem;
    border-radius: 2px;
    background: var(--muted);
  }

  .folder-icon::before {
    content: '';
    position: absolute;
    bottom: 80%;
    left: 0.08rem;
    width: 0.43rem;
    height: 0.2rem;
    border-radius: 2px 2px 0 0;
    background: inherit;
  }

  .folder-icon.small { width: 0.72rem; height: 0.49rem; background: var(--faint); }

  .file-icon {
    position: relative;
    display: inline-block;
    flex: 0 0 auto;
    width: 0.65rem;
    height: 0.82rem;
    border: 1px solid var(--faint);
    border-radius: 1px;
  }

  .file-icon::after {
    content: '';
    position: absolute;
    top: -1px;
    right: -1px;
    width: 0.24rem;
    height: 0.24rem;
    border-bottom: 1px solid var(--faint);
    border-left: 1px solid var(--faint);
    background: var(--background);
  }

  .shell {
    margin-top: 3rem;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: color-mix(in srgb, var(--background) 80%, transparent);
    backdrop-filter: blur(13px);
    -webkit-backdrop-filter: blur(13px);
  }

  .shell-bar {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.58rem 0.8rem;
    border-bottom: 1px solid var(--line);
    color: var(--faint);
    font-size: 0.59rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .shell-output { min-height: 4.5rem; max-height: 12rem; overflow-y: auto; padding: 0.78rem 0.85rem 0.18rem; }
  .shell-output :global(p) { margin: 0 0 0.3rem; color: var(--muted); font-size: 0.66rem; line-height: 1.55; overflow-wrap: anywhere; }
  .shell-output :global(b) { color: var(--text); font-weight: 500; }
  .shell-output :global(.shell-command), .shell-output :global(.shell-success) { color: var(--text); }
  .shell-output :global(.shell-error) { color: var(--muted); text-decoration: underline; text-decoration-style: dotted; }

  .shell-prompt {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.65rem 0.85rem 0.45rem;
    color: var(--muted);
    font-size: 0.72rem;
  }

  .shell-prompt input {
    min-width: 0;
    flex: 1;
    padding: 0;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--text);
    caret-color: var(--text);
    font: inherit;
  }

  .shell-prompt:focus-within { color: var(--text); }
  .shell-hint { margin: 0; padding: 0 0.85rem 0.75rem; color: var(--faint); font-size: 0.56rem; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }

  @media (max-width: 620px) {
    .filesystem-heading { align-items: start; flex-direction: column; gap: 0.45rem; }
    .tree-row { grid-template-columns: minmax(0, 1fr) 1rem; gap: 0.1rem; padding-block: 0.45rem; }
    .entry-description { padding-left: 1.48rem; white-space: normal; }
    .tree-row .entry-description { grid-column: 1; }
    .entry-arrow { grid-column: 2; grid-row: 1; opacity: 1; }
    .project-row .entry-description { display: none; }
    .shell-prompt { align-items: flex-start; flex-wrap: wrap; }
    .shell-prompt input { flex-basis: 100%; padding-left: 0.1rem; }
    .shell-bar span:last-child { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .tree-row { transition: none; }
  }
</style>
