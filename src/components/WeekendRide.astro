<section class="weekend-ride content-section" data-weekend-ride aria-labelledby="ride-command">
  <div class="ride-command-row">
    <p id="ride-command" class="ride-command">pawan@singapore:~$ ./weekend-ride --with=dog</p>
    <button class="ride-pedal" type="button" data-ride-pedal aria-describedby="ride-status">[ pedal ]</button>
  </div>

  <div class="ride-track" aria-hidden="true">
    <span class="ride-marker ride-marker-start">home</span>
    <span class="ride-marker ride-marker-finish">5 km</span>
    <div class="ride-party" data-ride-party>
      <pre class="ride-dog"> / \__
(    @\___
 /         O
/   (_____/
/_____/   U</pre>
      <pre class="ride-bike">   __o
 _ \&lt;,_
(_)/ (_)</pre>
    </div>
  </div>

  <p class="ride-status" id="ride-status" data-ride-status aria-live="polite">
    0.0 km · waiting at the lights
  </p>
</section>

<script>
  const rideMessages = [
    '0.0 km · waiting at the lights',
    '0.4 km · rolling out',
    '0.8 km · the dog has found the pace',
    '1.3 km · cruising past the park',
    '1.7 km · one very determined companion',
    '2.1 km · cadence: pleasantly unserious',
    '2.5 km · halfway snack debate',
    '2.9 km · still no dropped paws',
    '3.3 km · tailwind, probably',
    '3.8 km · the dog attacks',
    '4.2 km · holding the wheel',
    '4.6 km · sprint incoming',
    '5.0 km · dog wins by a nose',
  ];

  document.querySelectorAll<HTMLElement>('[data-weekend-ride]').forEach((ride) => {
    const pedal = ride.querySelector<HTMLButtonElement>('[data-ride-pedal]');
    const party = ride.querySelector<HTMLElement>('[data-ride-party]');
    const status = ride.querySelector<HTMLElement>('[data-ride-status]');

    if (!pedal || !party || !status) return;

    let step = 0;

    pedal.addEventListener('click', () => {
      if (step === rideMessages.length - 1) {
        step = 0;
      } else {
        step += 1;
      }

      const progress = (step / (rideMessages.length - 1)) * 100;
      party.style.setProperty('--ride-progress', `${progress}%`);
      status.textContent = rideMessages[step];
      pedal.textContent = step === rideMessages.length - 1 ? '[ ride again ]' : '[ pedal ]';

      party.classList.remove('is-pedalling');
      requestAnimationFrame(() => party.classList.add('is-pedalling'));
    });
  });
</script>

<style>
  .weekend-ride {
    padding: 1.1rem 0 0.8rem;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .ride-command-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .ride-command {
    margin: 0;
    color: var(--faint);
    font-size: 0.72rem;
  }

  .ride-pedal {
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--link);
    font: inherit;
    font-size: 0.72rem;
    cursor: pointer;
  }

  .ride-pedal:hover,
  .ride-pedal:focus-visible {
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .ride-pedal:focus-visible {
    outline: 1px solid var(--link);
    outline-offset: 0.35rem;
  }

  .ride-track {
    position: relative;
    height: 9rem;
    margin-top: 1rem;
    overflow: hidden;
    border-bottom: 1px dashed var(--line);
  }

  .ride-marker {
    position: absolute;
    bottom: 0.35rem;
    color: var(--faint);
    font-size: 0.58rem;
    text-transform: uppercase;
  }

  .ride-marker-start { left: 0; }
  .ride-marker-finish { right: 0; }

  .ride-party {
    --ride-progress: 0%;
    position: absolute;
    bottom: 0.8rem;
    left: min(var(--ride-progress), calc(100% - 10rem));
    display: flex;
    align-items: flex-end;
    gap: 0.35rem;
    width: 10rem;
    color: var(--muted);
    transition: left 320ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .ride-party pre {
    margin: 0;
    color: inherit;
    font: 500 0.58rem/1.05 var(--mono);
    white-space: pre;
  }

  .ride-bike { transform: translateY(-0.05rem); }

  .ride-party.is-pedalling .ride-bike {
    animation: bike-hop 260ms ease-out;
  }

  .ride-party.is-pedalling .ride-dog {
    animation: dog-bound 300ms ease-out 40ms;
  }

  .ride-status {
    margin: 0.65rem 0 0;
    color: var(--faint);
    font-size: 0.64rem;
    text-align: right;
  }

  @keyframes bike-hop {
    50% { transform: translateY(-0.3rem); }
  }

  @keyframes dog-bound {
    50% { transform: translateY(-0.2rem); }
  }

  @media (max-width: 620px) {
    .ride-command-row { align-items: flex-start; }
    .ride-command { max-width: 70%; overflow-wrap: anywhere; }
    .ride-track { height: 8.5rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .ride-party { transition: none; }
    .ride-party.is-pedalling .ride-bike,
    .ride-party.is-pedalling .ride-dog { animation: none; }
  }
</style>
