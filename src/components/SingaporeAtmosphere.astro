    animation: cloud-drift 95s linear infinite;
  }

  .atmosphere-clouds-two {
    top: 48%;
    background: radial-gradient(ellipse at 22% 50%, white 0 8%, transparent 25%), radial-gradient(ellipse at 61% 48%, white 0 10%, transparent 30%);
    animation: cloud-drift 140s linear -60s infinite reverse;
  }

  .atmosphere-horizon {
    top: 55%;
    height: 35%;
    background: radial-gradient(ellipse at 50% 100%, rgba(255,174,108,.5), transparent 58%);
