  .bird::before { left: 0; transform: rotate(12deg); }
  .bird::after { right: 0; transform: rotate(-12deg); animation-delay: -0.55s; }

  .atmosphere-clouds {
    position: absolute;
    right: -25%;
    left: -25%;
    height: 15%;
    opacity: var(--cloud-opacity);
    filter: blur(18px);
    transition: opacity 2s linear;
  }

  .atmosphere-clouds-one {
