    background: radial-gradient(circle, rgba(255,251,225,.98) 0 3%, rgba(255,211,137,.42) 4%, rgba(255,181,96,.16) 18%, transparent 68%);
    opacity: var(--sun-opacity);
    filter: blur(0.2px);
