    100% { translate: 115vw -0.6rem; }
  }

  @keyframes bird-flap {
    from { rotate: -8deg; }
    to { rotate: 22deg; }
  }

  @media (prefers-reduced-motion: reduce) {
    .atmosphere-stars,
    .atmosphere-clouds,
    .atmosphere-constellation,
    .constellation-star { animation: none; }

    .atmosphere-birds { display: none; }

    .atmosphere-sky,
    .atmosphere-stars,
    .atmosphere-constellation,
    .atmosphere-sun,
    .atmosphere-moon,
    .atmosphere-birds,
    .atmosphere-clouds,
    .atmosphere-horizon,
    .atmosphere-veil { transition: none; }
  }
</style>
