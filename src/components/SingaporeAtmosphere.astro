<div class="singapore-atmosphere" aria-hidden="true">
  <div class="atmosphere-sky"></div>
  <div class="atmosphere-stars atmosphere-stars-far"></div>
  <div class="atmosphere-stars atmosphere-stars-near"></div>
  <div class="atmosphere-constellation">
    <span class="constellation-star constellation-star-a"></span>
    <span class="constellation-star constellation-star-b"></span>
    <span class="constellation-star constellation-star-c"></span>
    <span class="constellation-star constellation-star-d"></span>
    <span class="constellation-star constellation-star-e"></span>
    <span class="constellation-star constellation-star-f"></span>
    <span class="constellation-star constellation-star-g"></span>
    <i class="constellation-line constellation-line-ab"></i>
    <i class="constellation-line constellation-line-bc"></i>
    <i class="constellation-line constellation-line-cd"></i>
    <i class="constellation-line constellation-line-de"></i>
    <i class="constellation-line constellation-line-df"></i>
    <i class="constellation-line constellation-line-cg"></i>
  </div>
  <div class="atmosphere-sun"></div>
  <div class="atmosphere-moon"></div>
  <div class="atmosphere-birds">
    <span class="bird-flight bird-flight-one"><i class="bird"></i></span>
    <span class="bird-flight bird-flight-two"><i class="bird"></i></span>
    <span class="bird-flight bird-flight-three"><i class="bird"></i></span>
  </div>
  <div class="atmosphere-clouds atmosphere-clouds-one"></div>
  <div class="atmosphere-clouds atmosphere-clouds-two"></div>
  <div class="atmosphere-horizon"></div>
  <div class="atmosphere-veil"></div>
</div>

<script>
  const root = document.documentElement;
  const singaporeClock = new Intl.DateTimeFormat('en-GB', {
    timeZone: 'Asia/Singapore',
    hour: '2-digit',
    minute: '2-digit',
    second: '2-digit',
    hourCycle: 'h23',
  });

  const skyStops = [
    { at: 0, top: '#03050b', middle: '#08101d', bottom: '#171522', veil: 0.3 },
    { at: 4.5, top: '#070b17', middle: '#171a31', bottom: '#51313e', veil: 0.36 },
    { at: 6.5, top: '#24364d', middle: '#a75e55', bottom: '#e7a468', veil: 0.58 },
    { at: 8, top: '#315d7d', middle: '#7597ad', bottom: '#d8b98f', veil: 0.65 },
    { at: 12, top: '#21638f', middle: '#65a0c1', bottom: '#c8c5ad', veil: 0.68 },
    { at: 16.5, top: '#2e6280', middle: '#7895a3', bottom: '#d6aa78', veil: 0.64 },
    { at: 18.5, top: '#252b48', middle: '#8d4f59', bottom: '#dd845e', veil: 0.52 },
    { at: 20, top: '#0b1020', middle: '#25213a', bottom: '#643b48', veil: 0.4 },
    { at: 24, top: '#03050b', middle: '#08101d', bottom: '#171522', veil: 0.3 },
  ];

  const signalMessages = [
    { from: 0, to: 5, text: 'night shift · the city is quiet, the systems are not' },
    { from: 5, to: 8, text: 'first light · before the traffic starts moving' },
    { from: 8, to: 12, text: 'morning build · the day is taking shape' },
    { from: 12, to: 17, text: 'peak load · singapore at full throughput' },
    { from: 17, to: 20, text: 'golden hour · the city changes pace' },
    { from: 20, to: 24, text: 'after hours · quieter streets, louder ideas' },
  ];

  const clamp = (value: number, min = 0, max = 1) => Math.min(max, Math.max(min, value));

  const hexToRgb = (hex: string) => {
    const value = Number.parseInt(hex.slice(1), 16);
    return [(value >> 16) & 255, (value >> 8) & 255, value & 255];
  };

  const mix = (from: string, to: string, amount: number) => {
    const start = hexToRgb(from);
    const end = hexToRgb(to);
    const channel = (index: number) => Math.round(start[index] + (end[index] - start[index]) * amount);
    return `rgb(${channel(0)} ${channel(1)} ${channel(2)})`;
  };

  const interpolateSky = (hour: number) => {
    const endIndex = skyStops.findIndex(({ at }) => at >= hour);
    const end = skyStops[Math.max(1, endIndex)];
    const start = skyStops[Math.max(0, endIndex - 1)];
    const progress = (hour - start.at) / (end.at - start.at);

    return {
      top: mix(start.top, end.top, progress),
      middle: mix(start.middle, end.middle, progress),
      bottom: mix(start.bottom, end.bottom, progress),
      veil: start.veil + (end.veil - start.veil) * progress,
    };
  };

  const celestialPosition = (progress: number) => {
    const altitude = Math.sin((progress - 0.25) * Math.PI * 2);
    return {
      x: progress * 100,
      y: 76 - Math.max(-0.15, altitude) * 58,
    };
  };

  const updateAtmosphere = () => {
    const now = new Date();
    const parts = Object.fromEntries(
      singaporeClock.formatToParts(now)
        .filter(({ type }) => type !== 'literal')
        .map(({ type, value }) => [type, value])
    );

    const hour = Number(parts.hour);
    const minute = Number(parts.minute);
    const second = Number(parts.second);
    const exactHour = hour + minute / 60 + second / 3600;
    const dayProgress = exactHour / 24;
    const moonProgress = (dayProgress + 0.5) % 1;
    const sun = celestialPosition(dayProgress);
    const moon = celestialPosition(moonProgress);
    const sky = interpolateSky(exactHour);
    const sunrise = clamp((exactHour - 5.5) / 1.25);
    const sunset = clamp((19.5 - exactHour) / 1.25);
    const daylight = Math.min(sunrise, sunset);
    const golden = clamp(1 - Math.min(Math.abs(exactHour - 6.5), Math.abs(exactHour - 18.5)) / 2);
    const stars = clamp(1 - daylight * 1.4, 0, 0.72);
    const morningIn = clamp((exactHour - 5.5) / 1.25);
    const morningOut = clamp((11.5 - exactHour) / 1.5);
    const birds = Math.min(morningIn, morningOut) * 0.62;

    root.style.setProperty('--sky-top', sky.top);
    root.style.setProperty('--sky-middle', sky.middle);
    root.style.setProperty('--sky-bottom', sky.bottom);
    root.style.setProperty('--sky-veil', `rgba(7, 9, 10, ${sky.veil.toFixed(3)})`);
    root.style.setProperty('--sun-x', `${sun.x}%`);
    root.style.setProperty('--sun-y', `${sun.y}%`);
    root.style.setProperty('--moon-x', `${moon.x}%`);
    root.style.setProperty('--moon-y', `${moon.y}%`);
    root.style.setProperty('--sun-opacity', `${clamp(daylight + golden * 0.18)}`);
    root.style.setProperty('--moon-opacity', `${clamp(1 - daylight * 1.2, 0.12, 0.88)}`);
    root.style.setProperty('--stars-opacity', `${stars}`);
    root.style.setProperty('--constellation-opacity', `${clamp(stars * 0.85, 0, 0.58)}`);
    root.style.setProperty('--birds-opacity', `${birds}`);
    root.style.setProperty('--cloud-opacity', `${0.045 + daylight * 0.08}`);
    root.style.setProperty('--horizon-opacity', `${0.08 + golden * 0.18}`);

    document.querySelectorAll<HTMLTimeElement>('[data-signal-time]').forEach((time) => {
      time.textContent = `${parts.hour}:${parts.minute}:${parts.second} SGT`;
      time.dateTime = now.toISOString();
    });

    const message = signalMessages.find(({ from, to }) => hour >= from && hour < to)?.text;
    document.querySelectorAll<HTMLElement>('[data-signal-caption]').forEach((caption) => {
      caption.textContent = message ?? 'local time, rendered as atmosphere';
    });
  };

  updateAtmosphere();
  window.setInterval(updateAtmosphere, 1000);
</script>

<style>
  :global(:root) {
    --sky-top: #03050b;
    --sky-middle: #08101d;
    --sky-bottom: #171522;
    --sky-veil: rgba(7, 9, 10, 0.3);
    --sun-x: 50%;
    --sun-y: 18%;
    --moon-x: 8%;
    --moon-y: 20%;
    --sun-opacity: 0;
    --moon-opacity: 0.75;
    --stars-opacity: 0.65;
    --constellation-opacity: 0.52;
    --birds-opacity: 0;
    --cloud-opacity: 0.05;
    --horizon-opacity: 0.08;
  }

  .singapore-atmosphere {
    position: fixed;
    z-index: 0;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .atmosphere-sky,
  .atmosphere-stars,
  .atmosphere-horizon,
  .atmosphere-veil {
    position: absolute;
    inset: 0;
  }

  .atmosphere-sky {
    background: linear-gradient(180deg, var(--sky-top) 0%, var(--sky-middle) 46%, var(--sky-bottom) 78%, #10110f 115%);
    transition: background 2s linear;
  }

  .atmosphere-stars {
    opacity: var(--stars-opacity);
    transition: opacity 2s linear;
  }

  .atmosphere-stars-far {
    background-image:
      radial-gradient(circle at 7% 12%, rgba(255,255,255,.75) 0 1px, transparent 1.4px),
      radial-gradient(circle at 17% 28%, rgba(255,255,255,.46) 0 1px, transparent 1.3px),
      radial-gradient(circle at 29% 9%, rgba(255,255,255,.58) 0 1px, transparent 1.4px),
      radial-gradient(circle at 42% 24%, rgba(255,255,255,.35) 0 1px, transparent 1.3px),
      radial-gradient(circle at 58% 11%, rgba(255,255,255,.7) 0 1px, transparent 1.4px),
      radial-gradient(circle at 71% 31%, rgba(255,255,255,.42) 0 1px, transparent 1.3px),
      radial-gradient(circle at 84% 8%, rgba(255,255,255,.55) 0 1px, transparent 1.4px),
      radial-gradient(circle at 94% 23%, rgba(255,255,255,.38) 0 1px, transparent 1.3px);
    animation: stars-breathe 7s ease-in-out infinite alternate;
  }

  .atmosphere-stars-near {
    background-image:
      radial-gradient(circle at 12% 39%, rgba(214,228,255,.7) 0 1px, transparent 1.6px),
      radial-gradient(circle at 35% 18%, rgba(255,244,214,.78) 0 1px, transparent 1.7px),
      radial-gradient(circle at 49% 37%, rgba(255,255,255,.62) 0 1px, transparent 1.6px),
      radial-gradient(circle at 67% 17%, rgba(214,228,255,.72) 0 1px, transparent 1.7px),
      radial-gradient(circle at 88% 36%, rgba(255,244,214,.66) 0 1px, transparent 1.6px);
    animation: stars-breathe 5s ease-in-out 1.5s infinite alternate-reverse;
  }

  .atmosphere-constellation {
    position: absolute;
    top: 10%;
    right: 9%;
    width: clamp(9rem, 18vw, 13rem);
    height: clamp(7rem, 14vw, 10rem);
    opacity: var(--constellation-opacity);
    transform: rotate(-6deg);
    transition: opacity 2s linear;
    animation: constellation-drift 36s ease-in-out infinite alternate;
  }

  .constellation-star,
  .constellation-line {
    position: absolute;
    display: block;
  }

  .constellation-star {
    width: 0.22rem;
    height: 0.22rem;
    border-radius: 50%;
    background: rgba(226, 237, 255, 0.92);
    box-shadow: 0 0 0.55rem rgba(186, 211, 255, 0.72);
    animation: constellation-pulse 4.8s ease-in-out infinite alternate;
  }

  .constellation-star:nth-child(even) { animation-delay: -2.2s; }
  .constellation-star-a { top: 20%; left: 15%; }
  .constellation-star-b { top: 42%; left: 38%; }
  .constellation-star-c { top: 60%; left: 50%; }
  .constellation-star-d { top: 54%; left: 65%; }
  .constellation-star-e { top: 35%; left: 82%; }
  .constellation-star-f { top: 85%; left: 72%; }
  .constellation-star-g { top: 88%; left: 36%; }

  .constellation-line {
    height: 1px;
    background: linear-gradient(90deg, rgba(185, 207, 238, 0.12), rgba(185, 207, 238, 0.42), rgba(185, 207, 238, 0.12));
    transform-origin: left center;
  }

  .constellation-line-ab { top: 21%; left: 16%; width: 32%; transform: rotate(36deg); }
  .constellation-line-bc { top: 43%; left: 39%; width: 23%; transform: rotate(42deg); }
  .constellation-line-cd { top: 61%; left: 51%; width: 16%; transform: rotate(-21deg); }
  .constellation-line-de { top: 55%; left: 66%; width: 24%; transform: rotate(-39deg); }
  .constellation-line-df { top: 56%; left: 66%; width: 34%; transform: rotate(68deg); }
  .constellation-line-cg { top: 62%; left: 50%; width: 31%; transform: rotate(132deg); }

  .atmosphere-sun,
