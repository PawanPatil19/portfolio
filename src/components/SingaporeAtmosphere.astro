    transition: opacity 2s linear;
  }

  .atmosphere-veil {
    background:
      linear-gradient(180deg, var(--sky-veil), rgba(10,12,12,.62) 60%, rgba(16,17,15,.94) 100%),
      radial-gradient(circle at 50% 12%, transparent 0, rgba(4,5,5,.18) 78%);
    transition: background 2s linear;
  }

  @keyframes cloud-drift {
    from { transform: translate3d(-8%, 0, 0); }
    to { transform: translate3d(8%, 0, 0); }
  }

  @keyframes stars-breathe {
    from { filter: brightness(0.72); }
    to { filter: brightness(1.18); }
  }

  @keyframes constellation-drift {
    from { transform: rotate(-6deg) translate3d(0, 0, 0); }
    to { transform: rotate(-5deg) translate3d(0.35rem, 0.18rem, 0); }
  }

  @keyframes constellation-pulse {
    from { opacity: 0.55; transform: scale(0.78); }
