---
import { type CollectionEntry, getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PortfolioDirectory from '../components/PortfolioDirectory.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const projects = (await getCollection('projects'))
  .filter((project: CollectionEntry<'projects'>) => project.data.featured)
  .sort((a: CollectionEntry<'projects'>, b: CollectionEntry<'projects'>) =>
    b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
  )
  .slice(0, 3);

---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <section class="intro">
    <p class="quiet-code">pawan@singapore:~$ whoami<span class="typing-cursor" aria-hidden="true"></span></p>
    <p class="intro-summary">
      I’m Pawan, a backend software engineer at
      <a href="https://www.linkedin.com/company/ventitechnologies/posts/?feedView=all" target="_blank" rel="noreferrer">Venti</a>,
      building real-time data systems and developer tools for autonomous vehicles.
    </p>
  </section>

  <PortfolioDirectory projects={projects} />
</BaseLayout>
