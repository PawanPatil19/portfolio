---
import { type CollectionEntry, getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const projects = (await getCollection('projects'))
  .filter((p: CollectionEntry<'projects'>) => p.data.featured)
  .sort((a: CollectionEntry<'projects'>, b: CollectionEntry<'projects'>) =>
    b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
  )
  .slice(0, 3);

const experience = [
  {
    date: 'Jun 2025 — Present',
    role: 'Backend Software Engineer',
    company: 'Venti',
  },
  {
    date: 'Jan 2024 — May 2025',
    role: 'Full Stack Software Engineer Intern',
    company: 'Venti',
  },
  {
    date: 'May 2023 — Aug 2023',
    role: 'Undergraduate Research Assistant',
    company: 'NUS Smart Systems Institute',
  },
  {
    date: 'May 2023 — Aug 2023',
    role: 'Student Assistant',
    company: 'National University of Singapore',
  },
];
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <!-- Hero -->
  <section class="hero">
    <h1 class="prompt">Pawan Patil<span class="cursor">▌</span></h1>
    <p class="subtitle">
      Junior software engineer building backend systems, data platforms, and developer tooling.
      Currently at <a href="https://www.linkedin.com/company/ventitechnologies/posts/?feedView=all" target="_blank" rel="noreferrer">Venti</a> working on real-time infrastructure for autonomous vehicles.
    </p>
    <p class="location">📍 Singapore · 🎓 B.Comp in Computer Science, National University of Singapore (2021–2025)</p>
    <div class="hero-links">
      <a href="mailto:pawanpatil663@gmail.com">email</a>
      <a href="https://github.com/PawanPatil19" target="_blank" rel="noreferrer">github</a>
      <a href="https://www.linkedin.com/in/pawan-kishor-patil/" target="_blank" rel="noreferrer">linkedin</a>
      <a href="/Pawan_Resume_Backend_Software_Engineer.pdf" target="_blank">resume.pdf</a>
    </div>
  </section>

  <hr />

  <!-- Experience & Skills -->
  <section>
    <div class="two-col">
      <div>
        <p class="section-label">Experience</p>
        <div class="timeline">
          {experience.map((item) => (
            <div class="timeline-item-compact">
              <span class="timeline-role">{item.role}</span>
              <span class="timeline-at"> @ </span>
              <span class="timeline-company">{item.company}</span>
              <span class="timeline-date-inline">{item.date}</span>
            </div>
          ))}
        </div>
        <a href="/experience" class="section-link">View full experience →</a>
      </div>
      <div>
        <p class="section-label">Tech I work with</p>
        <div class="tech-cloud">
          <span class="tag">Python</span>
          <span class="tag">C++</span>
          <span class="tag">Java</span>
          <span class="tag">TypeScript</span>
          <span class="tag">PostgreSQL</span>
          <span class="tag">ClickHouse</span>
          <span class="tag">Redis</span>
          <span class="tag">Kafka</span>
          <span class="tag">RabbitMQ</span>
          <span class="tag">Apache Iceberg</span>
          <span class="tag">Alluxio</span>
          <span class="tag">Spark</span>
          <span class="tag">Airflow</span>
          <span class="tag">Docker</span>
          <span class="tag">Kubernetes</span>
          <span class="tag">Linux</span>
          <span class="tag">Next.js</span>
          <span class="tag">REST APIs</span>
          <span class="tag">RabbitMQ</span>
          <span class="tag">Git</span>
        </div>
      </div>
    </div>
  </section>

  <hr />

  <!-- Featured Projects -->
  <section>
    <p class="section-label">Projects</p>
    <div class="project-list">
      {projects.map((project: CollectionEntry<'projects'>) => (
        <a class="project-card" href={`/projects/${project.id}/`}>
          <div class="card">
            <h3>{project.data.title}</h3>
            <p>{project.data.description}</p>
            <div class="project-tags">
              {project.data.stack.slice(0, 4).map((tech: string) => (
                <span class="tag">{tech}</span>
              ))}
            </div>
          </div>
        </a>
      ))}
    </div>
    <p style="margin-top: 1rem;">
      <a href="/projects" style="font-size: 0.85rem;">All projects →</a>
    </p>
  </section>
</BaseLayout>
