---
import { type CollectionEntry, getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const projects = (await getCollection('projects'))
  .filter((project: CollectionEntry<'projects'>) => project.data.featured)
  .sort((a: CollectionEntry<'projects'>, b: CollectionEntry<'projects'>) =>
    b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
  )
  .slice(0, 3);

const posts = (await getCollection('blog'))
  .filter((post: CollectionEntry<'blog'>) => !post.data.draft)
  .sort((a: CollectionEntry<'blog'>, b: CollectionEntry<'blog'>) =>
    b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
  )
  .slice(0, 3);
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <section class="intro">
    <p class="quiet-code">pawan@singapore:~$ whoami</p>
    <h1>I’m Pawan, a backend software engineer.</h1>
    <p>
      I build real-time data systems and developer tools at
      <a href="https://www.linkedin.com/company/ventitechnologies/posts/?feedView=all" target="_blank" rel="noreferrer">Venti</a>,
      where I work on infrastructure for autonomous vehicles.
    </p>
    <p>
      I like reliable software, clear abstractions, and understanding why systems behave the way they do.
      This site is where I keep my projects and notes from the things I learn along the way.
    </p>
    <p class="inline-links">
      <a href="mailto:pawanpatil663@gmail.com">[Email]</a>
      <a href="https://github.com/PawanPatil19" target="_blank" rel="noreferrer">[GitHub]</a>
      <a href="https://www.linkedin.com/in/pawan-kishor-patil/" target="_blank" rel="noreferrer">[LinkedIn]</a>
      <a href="/Pawan_Resume_Backend_Software_Engineer.pdf" target="_blank">[Resume]</a>
    </p>
  </section>

  <section class="content-section">
    <div class="section-title-row">
      <h2>Writing</h2>
      <a href="/blog">All notes →</a>
    </div>
    <div class="simple-list">
      {posts.map((post: CollectionEntry<'blog'>) => (
        <article class="simple-list-item">
          <time datetime={post.data.pubDate.toISOString()}><FormattedDate date={post.data.pubDate} /></time>
          <div>
            <h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3>
            <p>{post.data.description}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="content-section">
    <div class="section-title-row">
      <h2>Selected projects</h2>
      <a href="/projects">All projects →</a>
    </div>
    <div class="simple-list project-list-home">
      {projects.map((project: CollectionEntry<'projects'>) => (
        <article class="simple-list-item">
          <span class="list-marker">{project.data.stack[0]}</span>
          <div>
            <h3><a href={`/projects/${project.id}/`}>{project.data.title}</a></h3>
            <p>{project.data.description}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="content-section note-section">
    <h2>Currently</h2>
    <p>
      Working from Singapore, learning more about event-driven systems, storage engines, and the small
      engineering decisions that make production software easier to operate.
    </p>
  </section>
</BaseLayout>
