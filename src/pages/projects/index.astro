---
import { type CollectionEntry, getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_TITLE } from '../../consts';

const projects = (await getCollection('projects')).sort(
  (a: CollectionEntry<'projects'>, b: CollectionEntry<'projects'>) =>
    b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout title={`Projects — ${SITE_TITLE}`} description="Things I've built — side projects, experiments, and systems work.">
  <section>
    <h1 class="prompt">Projects</h1>
    <p class="subtitle" style="margin-bottom: 2rem;">
      Side projects, experiments, and systems I've built. Each one taught me something different.
    </p>
  </section>

  <section>
    <div class="project-list">
      {projects.map((project: CollectionEntry<'projects'>) => (
        <a class="project-card" href={`/projects/${project.id}/`}>
          <div class="card">
            <h3>{project.data.title}</h3>
            <p>{project.data.description}</p>
            <div class="project-tags">
              {project.data.stack.map((tech: string) => (
                <span class="tag">{tech}</span>
              ))}
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
